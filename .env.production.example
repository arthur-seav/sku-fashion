# Copy to .env on the server and fill in. Never commit the real file.
# Generate the two secrets on the server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"   -> DJANGO_SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   -> DB_PASSWORD
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=202-61-200-81.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://202-61-200-81.sslip.io
DJANGO_HSTS_SECONDS=3600

# Caddy (HTTPS certificate)
SITE_DOMAIN=202-61-200-81.sslip.io
ACME_EMAIL=

# PostgreSQL runs in the `db` container; compose.yaml sets DB_HOST and DB_PORT.
DB_NAME=sku_fashion
DB_USER=sku_fashion
DB_PASSWORD=

STORE_CURRENCY=USD
STORE_TAX_RATE=0.10
