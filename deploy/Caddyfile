# Caddy runs as the `caddy` service in compose.yaml; SITE_DOMAIN and ACME_EMAIL
# come from .env. With an email set, Caddy falls back to ZeroSSL if Let's Encrypt
# refuses the certificate (sslip.io is not on the Public Suffix List, so its
# weekly quota is shared by everyone).
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploaded product images and payment receipts, straight from disk.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Everything else goes to gunicorn in the `web` container.
	handle {
		request_body {
			max_size 10MB
		}
		reverse_proxy web:8000
	}
}
